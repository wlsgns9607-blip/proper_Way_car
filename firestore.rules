rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'wlsgns9607@gmail.com'; }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.uid is string 
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100;
    }

    function isValidReview(data) {
      return data.userId is string
        && data.pin is map
        && data.pin.x is number && data.pin.y is number
        && data.actualTime is number
        && data.aiSummary is string && data.aiSummary.size() <= 1000
        && data.createdAt is timestamp;
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time;
      allow update: if (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().diff(existing()).affectedKeys().hasOnly(['carModel', 'carSize', 'carPhotoUrl', 'name', 'birthDate', 'phoneNumber', 'lastActiveAt']);
    }

    // --- Chat Sessions ---
    match /chatSessions/{sessionId} {
      // Session Document
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || sessionId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin() || sessionId == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || sessionId == request.auth.uid);
      
      // Messages (Subcollections)
      match /{allPaths=**} {
        allow read, write: if isSignedIn() && (get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid || isAdmin() || sessionId == request.auth.uid);
      }
    }

    // --- Records ---
    match /records/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      match /userRecords/{recordId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
      }
    }

    // --- Reviews ---
    match /reviews/{reviewId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() 
        && isValidReview(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
