# Google Login (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Naver Login (Get from Naver Developers Console)
# You can use either with or without VITE_ prefix in the Settings menu
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
VITE_NAVER_CLIENT_ID=

# Kakao Login (Get from Kakao Developers Console)
# VITE_KAKAO_CLIENT_ID or KAKAO_CLIENT_ID or KAKAO_REST_API_KEY
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
VITE_KAKAO_CLIENT_ID=

# Gemini API Key (Get from Google AI Studio)
GEMINI_API_KEY=

# Firebase Config (Optional for persistence, but recommended for Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
